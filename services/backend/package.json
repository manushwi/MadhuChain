{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HoneyChain backend API - the single bridge between apps and Hyperledger Fabric",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset-data.ts",
    "operators:backfill": "tsx scripts/backfill-operator-ids.ts",
    "prisma:studio": "prisma studio",
    "sim:sensors": "tsx scripts/mock-sensors.ts",
    "analytics:run": "tsx src/workers/ai-worker.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@hyperledger/fabric-gateway": "^1.12.0",
    "@prisma/client": "^5.18.0",
    "bcrypt": "^5.1.1",
    "bwip-js": "^4.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
