# =============================================================================
# MadhuChain Backend - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (frontend dev/prod URLs)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:8081
# Bind address (0.0.0.0 to be reachable from other machines on the LAN)
HOST=0.0.0.0

# Auth
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
# Round count for bcrypt password hashing
BCRYPT_ROUNDS=10

# Database (TimescaleDB via docker/infra/docker-compose.yml)
DATABASE_URL=postgresql://madhuchain:madhuchain@localhost:5432/madhuchain

# Devices / gateways
# Shared API key the master gateway node uses to push sensor readings
DEVICE_API_KEY=change-me-device-key

# Redis (optional cache for /verify)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
VERIFY_CACHE_TTL_SECONDS=300

# =============================================================================
# Hyperledger Fabric - connection for the Fabric Gateway SDK
# =============================================================================
FABRIC_ENABLED=true
FABRIC_EVENT_INDEXER_ENABLED=false
# Optional first block for a fresh event index. Omit to resume after indexed data.
# FABRIC_EVENT_START_BLOCK=0
FABRIC_CHANNEL=madhuchannel
FABRIC_CONTRACT=madhuchain
# Paths are relative to services/backend
FABRIC_CONNECTION_PROFILE=../../chain/network/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/connection-org1.json
FABRIC_MSP_ID=Org1MSP
# Directory containing the default KVIC/Admin read identity
FABRIC_IDENTITY_DIR=../../chain/network/identities/Admin
FABRIC_IDENTITY_LABEL=admin
# TLS / gateway options
FABRIC_DISCOVERY_ENABLED=true
# Seeds for the Fabric test network (peer + orderer) if using embedded config
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_ORDERER_ENDPOINT=localhost:7050

# Barcode label generation
# Directory where generated label PDFs are served from
BARCODE_PUBLIC_BASE_URL=http://localhost:4000/barcodes

# =============================================================================
# Administrator registration
# Comma-separated one-time codes that let the first administrator self-register
# from the KVIC dashboard login screen ("Register Admin" tab). Each code is
# invalidated once used. Leave empty to disable public admin registration.
# =============================================================================
# ADMIN_REGISTRATION_CODES=kv-admin-2026,reserve-code

# =============================================================================
# AI hive/disease analysis (OpenRouter)
# Optional. When set and a hive is outside its normal band, the backend calls
# OpenRouter with the hive's telemetry/risk context for a real disease analysis.
# When unset (or the call fails), the API falls back to deterministic rules only.
# =============================================================================
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cache the LLM analysis per hive (seconds) to avoid repeat billing on refresh.
# AI_ANALYSIS_CACHE_TTL_SECONDS=3600
